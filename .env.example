PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASS=
DB_NAME=financial_db
DB_PORT=5432
DB_USE_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7

# CORS Configuration (separar multiplas origens por virgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:*

# Swagger
ENABLE_SWAGGER=true
SWAGGER_SERVER_URL=http://localhost:3000
